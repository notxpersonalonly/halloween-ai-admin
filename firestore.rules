rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'notxpersonalonly@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // A signed-in user may create/update only their basic profile.
    // Entitlement and billing fields are intentionally excluded.
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid','email','displayName','photoURL','createdAt','lastSeenAt'])
        && request.resource.data.uid == uid;
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','photoURL','lastSeenAt']));
      allow delete: if isAdmin();
    }

    // User can read only their own entitlement. Only admin or trusted server
    // (Admin SDK bypasses rules) can write entitlement documents.
    match /entitlements/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /subscriptions/{subscriptionId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if isAdmin() || (signedIn() && resource.data.published == true);
      allow create, update, delete: if isAdmin();
    }

    // Public app configuration is readable by signed-in app users.
    // Only the admin can publish changes.
    match /appConfig/{configId} {
      allow get: if isAdmin() || (signedIn() && configId == 'public');
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Promo codes are admin-only until a trusted redemption endpoint is added.
    match /promoCodes/{promoId} {
      allow read, write: if isAdmin();
    }

    // Deny every collection not explicitly allowed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
