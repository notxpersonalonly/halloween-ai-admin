rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'notxpersonalonly@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function isBlocked() {
      return exists(/databases/$(database)/documents/entitlements/$(request.auth.uid))
        && get(/databases/$(database)/documents/entitlements/$(request.auth.uid)).data.get('blocked', false) == true;
    }

    // A signed-in user may create/update only their basic profile.
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid','email','displayName','photoURL','createdAt','lastSeenAt'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email;
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','photoURL','lastSeenAt']));
      allow delete: if isAdmin();
    }

    // Written ONLY by the Halloween AI server (Admin SDK bypasses rules): payments, promo codes, blocking.
    // Nobody can write from a browser or the app, including the admin dashboard.
    match /entitlements/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow write: if false;
    }
    match /subscriptions/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Admin creates/disables codes; the server redeems them (and owns the redemptions subcollection).
    match /promoCodes/{code} {
      allow read, create, update, delete: if isAdmin();
      match /redemptions/{uid} { allow read: if isAdmin(); allow write: if false; }
    }

    match /announcements/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.published == true);
      allow create, update, delete: if isAdmin();
    }

    // Feedback and bug reports: any signed-in, non-blocked user can send one; only the admin reads them.
    match /feedback/{id} {
      allow create: if signedIn() && !isBlocked()
        && request.resource.data.keys().hasOnly(['uid','category','message','appVersion','device','createdAt','status'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.category in ['feedback','bug','other']
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 2000
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    // Append-only record of admin actions.
    match /adminLog/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['admin','action','target','detail','createdAt'])
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
